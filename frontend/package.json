{
  "name": "devflow-ai-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vue-tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && node scripts/check-ui.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.68.0",
    "dompurify": "^3.3.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0"
  }
}
